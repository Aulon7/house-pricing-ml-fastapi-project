# Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Regenerated by src/train.py
reports/
logs/

# Per-variant candidates, regenerated by "python -m src.train --features both".
# A single Random Forest pickle is 64MB, and git history keeps it forever.
# The shipped models/model.pkl and models/features.pkl stay tracked.
models/*/

# Secrets
.env
